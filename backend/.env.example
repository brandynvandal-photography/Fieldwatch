PORT=3000
DB_PATH=fieldwatch.db                 # on Railway, attach a Volume to the service and leave this unset: the database, radar frames and clips go on the volume
ADMIN_KEY=change-me
NWS_USER_AGENT=Fieldwatch/0.1 (you@example.com)
POLL_SECONDS=30                  # how often the weather service is asked; its answers are cached about 30 s, so faster buys nothing
CORS_ORIGIN=*                     # or the web build's origin, e.g. https://brandynvandal-photography.github.io
# TRUST_PROXY=1                   # hops between the internet and this process (Fly, Railway, nginx), so report rate limits see the phone's IP

# Push notifications. Leave these commented out until you have an APNs key from a paid
# developer account; without them alerts are stored and served but not pushed.
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.yourname.Fieldwatch   # must match bundleIdPrefix + name in ios/project.yml
# APNS_PRODUCTION=false

# Festival list. The curated data/festivals.json seeds an empty database; these keep the list growing.
# TICKETMASTER_KEY=               # free key from developer.ticketmaster.com; imports US festivals daily
# SEATGEEK_CLIENT_ID=             # free client id from seatgeek.com/account/develop; music_festival listings
# EDMTRAIN_KEY=                   # client key from edmtrain.com/developer-api; electronic festivals, event links shown as given
# WIKIDATA_IMPORT=true            # no key: US festivals from Wikidata, this year's dates read from each festival's own site (schema.org JSON-LD); false, 0 or no turns it off; needs a real NWS_USER_AGENT
# WIKIDATA_MAX_SITES=250          # festival sites read per run
# WIKIDATA_PAUSE_MS=400           # pause between two sites
# WIKIDATA_CACHE_DAYS=6           # a site's result (hit or miss) is kept this long before it is read again
# FESTIVAL_FEEDS=                 # comma-separated CSV/JSON URLs, e.g. a Google Sheet published to the web
IMPORT_HOURS=24
# LEAD_DAYS=7                     # a festival is on (listed, polled) from this many days before gates: early entry, vendors, crews
# TAIL_DAYS=1                     # and until this many days after it ends
# HEADS_UP_HOURS=3                # push a heads-up when the forecast turns stormy, windy, wet or dangerously hot within this many hours
# LIGHTNING=true                  # lightning codes from the GOES lightning mapper (public NOAA S3 buckets, no key) while a festival is on; false turns it off
# GLM_BUCKETS=noaa-goes19,noaa-goes18   # GOES-East and GOES-West; add noaa-goes16 if the East files are still landing there
# LIGHTNING_SECONDS=20            # how often the buckets are read; a file lands every 20 s
# IEMRE_URL=https://mesonet.agron.iastate.edu/iemre   # the daily rain analysis behind "rain in the last two days"; no key
# OVERPASS_URL=https://overpass-api.de/api/interpreter          # OpenStreetMap land use under each festival, one query per festival ever; no key
# SDA_URL=https://sdmdataaccess.sc.egov.usda.gov/Tabular/post.rest   # the USDA soil survey at each festival, once; no key

# Web push: the web build's warnings on a phone's Home Screen. The server makes a VAPID key pair on first boot
# and keeps it in the database; set these two (from `npm run vapid`) only to bring your own.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://brandynvandal-photography.github.io/Fieldwatch/   # or mailto:you@example.com; who to contact about the pushes
# SITE_URL=https://brandynvandal-photography.github.io/Fieldwatch/        # where a tapped notification opens

# Incidents
NODE_KEY=change-me-too            # shared with receiver nodes (fieldwatch-node)
AUDIO_DIR=./audio
INCIDENT_AUTO_PUBLISH=true        # scanner incidents publish immediately; attendee reports always queue
OPENAI_API_KEY=                   # optional: transcribe clips here when a node couldn't

# Radar loop: NEXRAD composites from the Iowa Environmental Mesonet archive, no key. Frames are
# cached on disk per festival and served to phones from here, so the archive sees one client.
RADAR_DIR=./radar
RADAR_HOURS=12
RADAR_STEP_MINUTES=10
RADAR_REFRESH_SECONDS=300
# RADAR_WMS=https://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0q-t.cgi
# RADAR_LAYER=nexrad-n0q-wmst
