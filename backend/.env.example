# Everything in this file is optional. A bare deployment runs with none of it: the database seeds itself from
# data/festivals.json, the admin key and the web push key pair are made on the first boot and kept in the database (the
# admin key is printed once, in that boot's log), and every service we read is free and keyless, reached with a
# User-Agent that names the app's own page. Attach a volume (Railway announces it, and DB_PATH, RADAR_DIR and AUDIO_DIR
# follow it) and that is the whole setup. Set a line here only to change something.

# PORT=3000                       # hosts set this themselves
# DB_PATH=fieldwatch.db           # default: fieldwatch.db beside the code, or on the Railway volume
# ADMIN_KEY=                      # the key behind the staff screens. Unset, the server makes one on first boot and prints it once; set this to replace a lost one
# NWS_USER_AGENT=Fieldwatch/1.0 (a mailbox you read)   # who we are to the weather service, the radar archive, Wikidata and festival sites. Default: Fieldwatch/<version> (+SITE_URL), a contact they can reach
# SITE_URL=https://brandynvandal-photography.github.io/Fieldwatch/   # where the web build lives: where a tapped notification opens, what the default User-Agent names
# POLL_SECONDS=30                 # how often the weather service is asked; its answers are cached about 30 s, so faster buys nothing
# POLL_CONCURRENCY=3              # festivals polled at once in a pass; a pass that outruns POLL_SECONDS is skipped and counted (/health polling.overruns)
# NWS_TIMEOUT_MS=10000            # a weather service call that takes longer is given up; a timeout or a 5xx is tried once more after NWS_RETRY_MS (1000)
# CORS_ORIGIN=*                   # or the web build's origin, e.g. https://brandynvandal-photography.github.io
# PUSH_ENDPOINT_HOSTS=            # push services accepted beyond Apple, Google, Mozilla and Microsoft (comma-separated hosts), or any
# SSE_PER_IP=20                   # live streams one address may hold open
# DIGEST_HOUR=7                   # the morning brief, in each festival's own clock; off to send none
# HOUSEKEEPING_HOURS=24           # how often old incidents, audio, posts and stale radar frames are shed
# INCIDENT_KEEP_DAYS=30
# POST_KEEP_DAYS=90
# LOG_KEEP_DAYS=180                # the record of what happened at each festival (GET /festivals/:id/log)
# TRUST_PROXY=1                   # hops between the internet and this process (nginx, Fly), so report rate limits see the phone's IP; Railway sets itself

# Push to the iOS app. Leave these out until there is an APNs key from a paid developer account; without them alerts
# are stored, served and pushed to browsers, just not to the native app.
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.yourname.Fieldwatch   # must match bundleIdPrefix + name in ios/project.yml
# APNS_PRODUCTION=false

# Web push: the web build's warnings on a phone's Home Screen. The server makes a VAPID key pair on first boot and keeps
# it in the database; set these two (from `npm run vapid`) only to bring your own.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=                  # who to contact about the pushes: an https URL or mailto:; default SITE_URL

# Festival list. The curated data/festivals.json seeds an empty database; Wikidata and each festival's own site keep it
# growing with no key; these add more.
# TICKETMASTER_KEY=               # free key from developer.ticketmaster.com; imports US festivals daily
# SEATGEEK_CLIENT_ID=             # free client id from seatgeek.com/account/develop; music_festival listings
# EDMTRAIN_KEY=                   # client key from edmtrain.com/developer-api; electronic festivals, event links shown as given
# WIKIDATA_IMPORT=true            # no key: US festivals from Wikidata, this year's dates read from each festival's own site (schema.org JSON-LD); false, 0 or no turns it off
# WIKIDATA_MAX_SITES=250          # festival sites read per run
# WIKIDATA_PAUSE_MS=400           # pause between two sites
# WIKIDATA_CACHE_DAYS=6           # a site's result (hit or miss) is kept this long before it is read again
# FESTIVAL_FEEDS=                 # comma-separated CSV/JSON URLs, e.g. a Google Sheet published to the web
# IMPORT_HOURS=24
# BACKUP_DIR=                     # where the daily database copies go; default: a backups folder beside DB_PATH (on the volume)
# BACKUP_HOURS=24                 # how often
# BACKUP_KEEP=7                   # how many to keep

# LEAD_DAYS=7                     # a festival is on (listed, polled) from this many days before gates: early entry, vendors, crews
# TAIL_DAYS=1                     # and until this many days after it ends
# HEADS_UP_HOURS=3                # push a heads-up when the forecast turns stormy, windy, wet or dangerously hot within this many hours
# LIGHTNING=true                  # lightning codes from the GOES lightning mapper (public NOAA S3 buckets, no key) while a festival is on; false turns it off
# GLM_BUCKETS=noaa-goes19,noaa-goes18   # GOES-East and GOES-West; add noaa-goes16 if the East files are still landing there
# LIGHTNING_SECONDS=20            # how often the buckets are read; a file lands every 20 s
# IEMRE_URL=https://mesonet.agron.iastate.edu/iemre   # the daily rain analysis behind "rain in the last two days"; no key
# OVERPASS_URL=https://overpass-api.de/api/interpreter          # OpenStreetMap land use under each festival, one query per festival ever; no key
# SDA_URL=https://sdmdataaccess.sc.egov.usda.gov/Tabular/post.rest   # the USDA soil survey at each festival, once; no key
# NLCD_URL=https://www.mrlc.gov/geoserver/mrlc_display/NLCD_2021_Land_Cover_L48/wms   # the national land cover map, read at the point when OpenStreetMap has nothing; no key
# NLCD_LAYER=NLCD_2021_Land_Cover_L48   # its WMS layer; a newer year of the Annual NLCD goes here when MRLC publishes it

# Incidents
# NODE_KEY=                       # shared with receiver nodes (fieldwatch-node); set it when there is a node. Without it the upload routes answer 401
# AUDIO_DIR=./audio               # clips from the node; on the Railway volume by default
# INCIDENT_AUTO_PUBLISH=true      # scanner incidents publish immediately; attendee reports always queue
# OPENAI_API_KEY=                 # optional: transcribe clips here when a node couldn't

# Radar loop: NEXRAD composites from the Iowa Environmental Mesonet archive, no key. Frames are cached on disk per
# festival and served to phones from here, so the archive sees one client.
# RADAR_DIR=./radar               # on the Railway volume by default
# RADAR_HOURS=12
# RADAR_STEP_MINUTES=10
# RADAR_REFRESH_SECONDS=300
# RADAR_WMS=https://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0q-t.cgi
# RADAR_LAYER=nexrad-n0q-wmst
