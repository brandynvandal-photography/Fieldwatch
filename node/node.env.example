BACKEND_URL=https://your-backend.example.com
NODE_KEY=change-me-too              # must match NODE_KEY on the backend
FESTIVAL_ID=hulaween-2026           # id from data/festivals.json
NODE_NAME="Fieldwatch receiver"     # what phones see when they find it; quote values with spaces
WHISPER_MODEL=base.en               # tiny.en on a Pi 4, base.en on a Pi 5 or a laptop
RECORDINGS_DIR=recordings           # trunk-recorder's captureDir
LOCAL_PORT=8080
KEEP_HOURS=48
HOTSPOT_SSID=Fieldwatch
HOTSPOT_PASSWORD=change-me-now
