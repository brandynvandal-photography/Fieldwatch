<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">Fieldwatch receiver on %h</name>
  <service>
    <type>_fieldwatch-node._tcp</type>
    <port>8080</port>
    <txt-record>path=/incidents</txt-record>
  </service>
</service-group>
